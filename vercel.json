{
  "functions": {
    "src/server/api/*.ts": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/src/server/api/:path*"
    }
  ],
  "env": {
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase-service-role-key",
    "VITE_APP_URL": "@app-url"
  }
}