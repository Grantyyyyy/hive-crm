# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — ONLY used in serverless functions and dev API server.
# NEVER expose this key in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URL (used in invitation email redirects)
APP_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Resend — Email delivery service (free tier available)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_your_api_key

# Optional: Customize the "from" email address
# Default: onboarding@resend.dev (Resend test domain)
EMAIL_FROM=noreply@yourdomain.com

# Optional: Company name shown in emails
COMPANY_NAME=Your Company
